# Google AI Studio -> https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Serper.dev -> https://serper.dev (2500 free searches)
SERPER_API_KEY=your_serper_key_here

# Optional overrides.
# Google retires specific model versions for new API keys. If you get a 404 saying
# a model "is no longer available to new users", set a current one here.
# On the free tier gemini-3.6-flash allows ~5 requests/minute; a flash-lite model
# gives more headroom if you hit waits.
# CHAT_MODEL=gemini-3.6-flash
# CREW_MODEL=gemini/gemini-3.6-flash
# EMBED_MODEL=models/gemini-embedding-001

# RESEARCH_CACHE_HOURS=24   # how long researched rates stay fresh
# MAX_RESEARCH_RETRIES=1    # extra crew passes for rates that failed validation
# CREW_MAX_RPM=4            # throttle to stay under the free-tier rate limit
